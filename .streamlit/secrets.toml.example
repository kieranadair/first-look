# Example values only. Never commit an actual secrets.toml.
# Copy these fields into Streamlit Community Cloud Secrets after provider setup.

[providers]
typesafe_api_key = "REPLACE_WITH_TYPESAFE_API_KEY"
typesafe_model = "jev-latest"

tabpfn_token = "REPLACE_WITH_TABPFN_TOKEN"
tabpfn_model_path = "auto"

openai_api_key = "REPLACE_WITH_OPENAI_API_KEY"
openai_model = "gpt-6.1-terra"
openai_reasoning_effort = "medium"


# All three services are integral. No visitor setup or provider mode flags.
# Configure provider-enforced usage limits in the owner accounts.
